      "facebook": null,
      "linkedin": null
    }
  },
  "claddingLayers": {
    "abodo": "abodo",
    "aluminium": "aluminium",
    "default": "standard"
  },
  "stack": [
    {
      "slot": "ground",
      "src": "hardplants_{roof}",
      "when": ["hardscaping", "landscaping"]
    },
    {
      "slot": "ground",
      "src": "hard_{roof}",
      "when": ["hardscaping"],
      "unless": ["landscaping"]
    },
    {
      "slot": "ground",
      "src": "lawn_{roof}",
      "when": ["landscaping"],
      "unless": ["hardscaping"]
    },
    {
      "slot": "shadow",
      "src": "shadow_{roof}",
      "unless": ["hardscaping", "landscaping"]
    },
    {
      "slot": "house",
      "src": "house_{roof}_{palette}_{cladding}"
    },
    {
      "slot": "deck",
      "src": "deck_{palette}",
      "when": ["hardscaping"]
    },
    {
      "slot": "plants",
      "src": "plantsdeck_{roof}",
      "when": ["landscaping", "hardscaping"]
    },
    {
      "slot": "plants",
      "src": "plants_{roof}",
      "when": ["landscaping"],
      "unless": ["hardscaping"]
    },
    {
      "slot": "tank",
      "src": "tank_{roof}_{palette}",
      "when": ["tank"]
    },
    {
      "slot": "battery",
      "src": "battery",
      "when": ["solar"]
    },
    {
      "slot": "screens",
      "src": "screens_{roof}_{palette}",
      "when": ["screens"]
    },
    {
      "slot": "wastewater",
      "src": "wastewater",
      "when": ["wastewater"]
    },
    {
      "slot": "ac",
      "src": "ac",
      "when": ["ac"]
    },
    {
      "slot": "solar",
      "src": "solar_{roof}",
      "when": ["solar"]
    },
    {
      "slot": "flue",
      "src": "flue_{roof}_{palette}",
      "when": ["fireplace"]
    }
  ],
