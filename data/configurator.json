      "required": true,
      "options": ["Yes", "Not yet, I'm looking", "No"]
    },
    {
      "id": "site",
      "label": "Site characteristics",
      "type": "select",
      "required": true,
      "options": ["Flat", "Gentle slope", "Steep slope", "Coastal", "Rural", "Urban section", "Not sure yet"]
    },
    {
      "id": "preference",
      "label": "Home preference",
      "type": "select",
      "required": true,
      "options": [
        "Main home",
        "Holiday home",
        "Minor dwelling / granny flat",
        "Rental or short stay",
        "Home office or studio",
        "Commercial space"
      ]
    },
    {
      "id": "floorArea",
      "label": "Desired floor area (m2)",
      "type": "number",
      "required": false
    },
    {
      "id": "budget",
      "label": "Budget",
      "type": "select",
      "required": true,
      "options": ["Under $150k", "$150k to $250k", "$250k to $400k", "$400k to $600k", "Over $600k"]
    },
    {
      "id": "timeline",
      "label": "Timeline",
      "type": "select",
      "required": false,
      "options": ["Within 6 months", "6 to 12 months", "12 to 24 months", "Just exploring"]
    },
    {
      "id": "finance",
      "label": "Finance pre-approved?",
      "type": "select",
      "required": false,
      "options": ["Yes", "In progress", "No", "Not needed"]
    },
    {
      "id": "notes",
      "label": "Anything else?",
      "type": "textarea",
      "required": false
    }
